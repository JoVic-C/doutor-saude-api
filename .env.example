# ─── Scheduler (envios automáticos) ───────────────────
# SCHEDULER_ENABLED=false desativa os disparos automáticos.
# SCHEDULER_CRON: padrão "0 9 * * *" = todo dia às 09:00 (America/Sao_Paulo).
SCHEDULER_ENABLED=true
SCHEDULER_CRON=0 9 * * *
SCHEDULER_TIMEZONE=America/Sao_Paulo
SCHEDULER_DIAS_CONFIRMACAO=1
SCHEDULER_DIAS_LEMBRETE=3
